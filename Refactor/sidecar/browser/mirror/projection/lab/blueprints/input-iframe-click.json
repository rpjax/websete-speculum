{
  "id": "input-iframe-click",
  "description": "OS ABS — nested context click (contextId=2) via frame-aware resolve + ABS coords",
  "sessionPolicy": "cold",
  "queues": [
    {
      "name": "main",
      "actions": [
        { "id": "boot", "type": "boot", "params": { "url": "fixtures/iframe-open.html" } },
        { "id": "wait", "type": "sleep", "dependsOn": ["boot"], "params": { "ms": 6500 } },
        {
          "id": "click-inner",
          "type": "pushInput",
          "dependsOn": ["wait"],
          "params": {
            "sequence": [
              {
                "type": "resolveAndClick",
                "selector": "#inner-click",
                "contextId": 2
              }
            ]
          }
        },
        { "id": "wait-click", "type": "sleep", "dependsOn": ["click-inner"], "params": { "ms": 900 } },
        {
          "id": "assert-inner",
          "type": "evaluate",
          "dependsOn": ["wait-click"],
          "params": {
            "expression": "(() => { const f = document.getElementById('child'); const st = f?.contentDocument?.getElementById('inner-status')?.getAttribute('data-state'); if (st !== 'clicked') throw new Error('inner status=' + st); return 'ok'; })()"
          }
        },
        { "id": "writeDossier", "type": "writeDossier", "dependsOn": ["assert-inner"] }
      ]
    }
  ]
}
