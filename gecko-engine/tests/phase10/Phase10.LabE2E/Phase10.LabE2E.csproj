      Test runner only. WSL builds under /mnt/c (NTFS) cannot chmod the native apphost;
      A5 launches via `dotnet phase10-lab-e2e.dll`. Product Speculum.Supervisor keeps UseAppHost.
    -->
    <UseAppHost>false</UseAppHost>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\..\supervisor\src\Speculum.Gecko.Abi\Speculum.Gecko.Abi.csproj" />
    <ProjectReference Include="..\..\..\supervisor\src\Speculum.Supervisor\Speculum.Supervisor.csproj" />
  </ItemGroup>
</Project>
