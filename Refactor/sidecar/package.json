{
  "name": "speculum-sidecar-refactor",
  "version": "0.1.0",
  "private": true,
  "description": "Speculum sidecar refactor — gRPC host over BrowserSession",
  "scripts": {
    "build:virtual": "esbuild browser/mirror/projection/virtual/bootstrap.ts --bundle --format=iife --platform=browser --target=es2022 --outfile=dist/browser/mirror/projection/virtual.js",
    "build:lab-client": "esbuild browser/mirror/projection/lab/client/main.ts --bundle --format=iife --platform=browser --target=es2022 --outfile=browser/mirror/projection/lab/static/client.js",
    "build:producer": "npm run build:virtual",
    "build:inpage": "npm run build:virtual",
    "build": "npm run build:virtual && npm run build:lab-client && tsc",
    "dev:virtual": "npm run build:virtual -- --watch",
    "dev:producer": "npm run dev:virtual",
    "dev:inpage": "npm run dev:virtual",
    "start": "node dist/index.js",
    "dev": "ts-node index.ts",
    "lab:projection": "npm run build:virtual && npm run build:lab-client && tsc && node dist/browser/mirror/projection/lab/index.js",
    "smoke:projection-lab": "npm run build:virtual && npm run build:lab-client && tsc && node scripts/smoke-projection-lab.js",
    "smoke": "npm run build && node dist/smoke.js",
    "smoke:remote": "npm run build && node dist/smoke-remote.js",
    "unit": "npm run build && node dist/unit.js",
    "test": "npm run unit",
    "smoke:virtual-console": "npm run build:virtual && node scripts/smoke-virtual-console.js"
  },
  "dependencies": {
    "@grpc/grpc-js": "^1.12.6",
    "@grpc/proto-loader": "^0.7.13",
    "@napi-rs/canvas": "^1.0.2",
    "koffi": "^3.1.2",
    "patchright": "1.49.1",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/ws": "^8.18.1",
    "esbuild": "^0.25.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.4.0"
  }
}
