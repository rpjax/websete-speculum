          "interval": "15s",
          "timeout": "5s",
          "startPeriod": "15s",
          "retries": 3
        },
        "labels": [
          "traefik.enable=true",
          "traefik.http.routers.speculum-web.rule=Host(`${PUBLIC_HOST}`) && PathPrefix(`/`)",
          "traefik.http.routers.speculum-web.entrypoints=websecure",
          "traefik.http.routers.speculum-web.tls.certresolver=le",
          "traefik.http.routers.speculum-web.priority=1",
          "traefik.http.routers.speculum-web.service=speculum-web",
          "traefik.http.services.speculum-web.loadbalancer.server.port=80"
        ]
      }
    ],
    "volumes": [
      { "name": "speculum-refactor-data" },
      { "name": "traefik-letsencrypt" }
    ]
  },
  "test": {
