{
  "id": "document-churn",
  "description": "Launch under document churn — establish + install telemetry",
  "sessionPolicy": "cold",
  "fold": "document-churn",
  "queues": [
    {
      "name": "main",
      "actions": [
        {
          "id": "boot",
          "type": "boot",
          "params": { "url": "fixtures/document-churn.html?mode=hold&n=3" }
        },
        {
          "id": "wait-establish",
          "type": "sleep",
          "dependsOn": ["boot"],
          "params": { "ms": 2000 }
        },
        {
          "id": "start-churn",
          "type": "evaluate",
          "dependsOn": ["wait-establish"],
          "params": {
            "virtual": true,
            "expression": "typeof globalThis.__documentChurnStart==='function'&&globalThis.__documentChurnStart()"
          }
        },
        {
          "id": "wait-settle",
          "type": "sleep",
          "dependsOn": ["start-churn"],
          "params": { "ms": 6000 }
        },
        {
          "id": "probe-launch",
          "type": "probe.launchTelemetry",
          "dependsOn": ["wait-settle"]
        },
        { "id": "fold", "type": "fold", "dependsOn": ["probe-launch"], "params": { "ruleset": "document-churn" } },
        { "id": "writeDossier", "type": "writeDossier", "dependsOn": ["fold"] }
      ]
    }
  ]
}
