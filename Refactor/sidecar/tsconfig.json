{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "lib": ["ES2022"],
    "outDir": "dist",
    "rootDir": ".",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "declaration": false,
    "sourceMap": true
  },
  "include": ["./**/*.ts"],
  "exclude": [
    "node_modules",
    "dist",
    "browser/mirror/projection/virtual",
    "browser/mirror/projection/lab/client",
    "browser/mirror/projection/client",
    "browser/mirror/projection/bus",
    "browser/mirror/projection/runtime"
  ]
}
