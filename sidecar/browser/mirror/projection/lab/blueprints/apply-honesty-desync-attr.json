{
  "id": "apply-honesty-desync-attr",
  "description": "ATTR desync — inject NODE_NEW with invalid attr name (DOM client required)",
  "sessionPolicy": "cold",
  "fold": "apply-honesty-desync",
  "queues": [
    {
      "name": "main",
      "actions": [
        { "id": "boot", "type": "boot", "params": { "url": "fixtures/static-dom.html" } },
        { "id": "wait-settle", "type": "sleep", "dependsOn": ["boot"], "params": { "ms": 2500 } },
        {
          "id": "inject-attr",
          "type": "injectFrame",
          "dependsOn": ["wait-settle"],
          "continueOnFail": true,
          "params": { "kind": "attr" }
        },
        { "id": "fold", "type": "fold", "awaits": ["inject-attr"], "params": { "ruleset": "apply-honesty-desync", "kind": "attr" } },
        { "id": "writeDossier", "type": "writeDossier", "dependsOn": ["fold"] }
      ]
    }
  ]
}
