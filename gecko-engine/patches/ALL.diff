+  static void Startup();
+  static SpeculumProjectionRuntime& Get();
+
+  void DeliverFrame(uint32_t aContextId, uint64_t aDocToken, uint32_t aSequence,
+                    base::ProcessId aChildPid, nsTArray<uint8_t>& aFrame);
+
+ private:
+  SpeculumProjectionRuntime();
+  ~SpeculumProjectionRuntime();
