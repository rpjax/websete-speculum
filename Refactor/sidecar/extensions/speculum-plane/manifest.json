{
  "manifest_version": 3,
  "name": "Speculum Plane",
  "version": "1.0",
  "description": "Extension-mediated loopback WebSocket for PageProjection (bypasses page LNA/CSP).",
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_start",
      "all_frames": false
    }
  ],
  "host_permissions": [
    "*://127.0.0.1/*",
    "*://localhost/*",
    "ws://127.0.0.1/*",
    "ws://localhost/*",
    "wss://127.0.0.1/*",
    "wss://localhost/*"
  ]
}
