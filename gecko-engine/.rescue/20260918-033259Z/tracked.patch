-    bool succeeded = true;
-    for (uint32_t i = 0; succeeded && i < ipcBlobs.Length(); ++i) {
-      RefPtr<BlobImpl> impl = IPCBlobUtils::Deserialize(ipcBlobs[i]);
-      succeeded = child->AppendBlobImpl(impl);
