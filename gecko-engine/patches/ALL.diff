+using mozilla::ErrorResult;
+using mozilla::StaticMutex;
+using mozilla::StaticMutexAutoLock;
+using mozilla::SystemPrincipal;
+using mozilla::UniquePtr;
+using mozilla::dom::BrowsingContext;
