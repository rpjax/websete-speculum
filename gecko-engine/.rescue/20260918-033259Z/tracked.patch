+NS_IMPL_ISUPPORTS(SpeculumProjectionRuntime::Impl::ProgressSink,
+                  nsIWebProgressListener, nsISupportsWeakReference)
+
+NS_IMPL_ISUPPORTS(SpeculumProjectionRuntime::Impl::SoleChromeGuard,
