{
  "dev": {
    "namespace": "speculum-refactor",
    "network": "speculum-refactor-dev",
    "containers": [
      {
        "id": "traefik",
        "imageRef": "traefik:v3.6.1",
        "dependsOn": [{ "id": "api", "condition": "service_healthy" }],
        "command": [
          "--api.dashboard=false",
          "--providers.docker=true",
          "--providers.docker.exposedbydefault=false",
          "--providers.docker.network=speculum-refactor-dev",
          "--entrypoints.web.address=:80"
        ],
        "ports": [
          { "host": 8080, "container": 80 }
        ],
        "volumes": [
          { "host": "/var/run/docker.sock", "container": "/var/run/docker.sock:ro" }
        ]
      },
      {
        "id": "sidecar",
        "image": "speculum-refactor-sidecar",
        "context": ".",
        "dockerfile": "sidecar/Dockerfile",
        "init": true,
        "capAdd": ["SYS_ADMIN", "MKNOD"],
        "shmSize": "2gb",
        "compose": {
          "devices": ["/dev/uinput:/dev/uinput"],
          "device_cgroup_rules": [
            "c 10:223 rwm",
            "c 13:* rwm"
          ]
        },
        "env": [
          { "name": "NODE_ENV", "value": "production" },
          { "name": "SPECULUM_BROWSER", "value": "patchright" },
          { "name": "CHROME_EXECUTABLE", "value": "/usr/bin/google-chrome" },
          { "name": "SPECULUM_GRPC_PORT", "value": "50051" },
          { "name": "SPECULUM_HEALTH_PORT", "value": "3001" }
        ],
        "healthcheck": {
          "test": ["CMD", "curl", "-sf", "http://localhost:3001/health"],
          "interval": "15s",
          "timeout": "5s",
          "startPeriod": "60s",
          "retries": 5
        }
      },
      {
        "id": "api",
        "image": "speculum-refactor-api",
        "context": ".",
        "dockerfile": "Speculum.Api/Dockerfile",
        "dependsOn": [{ "id": "sidecar", "condition": "service_healthy" }],
        "healthcheck": {
          "test": ["CMD", "curl", "-sf", "http://localhost:8080/w7s/health/live"],
          "interval": "15s",
          "timeout": "5s",
          "startPeriod": "25s",
          "retries": 5
        },
        "env": [
          { "name": "ASPNETCORE_ENVIRONMENT", "value": "Production" },
          { "name": "ASPNETCORE_URLS", "value": "http://0.0.0.0:8080" },
          { "name": "SPECULUM_WEBTRANSPORT_PORT", "value": "8443" },
          { "name": "SPECULUM_BYPASS_API_AUTH", "value": "true" },
          { "name": "Database__Path", "value": "/data/speculum.db" },
          { "name": "Sidecar__GrpcAddress", "value": "http://sidecar:50051" },
          { "name": "Telemetry__Host__ProcPath", "value": "/host/proc" },
          { "name": "Telemetry__Docker__Endpoint", "value": "unix:///var/run/docker.sock" },
          { "name": "Navigation__DefaultTargetHost", "value": "www.google.com" },
          { "name": "Navigation__AllowedMainFrameUrls__0__Domain__Scope", "value": "Any" },
          { "name": "ResourceManagement__Sessions__MaxConcurrentSessions", "value": "10" },
          { "name": "Sessions__DetachedSessionTimeout", "value": "00:00:03" },
          { "name": "Sessions__IsJsBridgeEnabled", "value": "true" },
          { "name": "Sessions__InputMultiplexingPolicy__Access", "value": "Shared" },
          { "name": "Sessions__ViewportPolicy__Default__Width", "value": "1280" },
          { "name": "Sessions__ViewportPolicy__Default__Height", "value": "720" },
          { "name": "Sessions__ViewportPolicy__Minimum__Width", "value": "100" },
          { "name": "Sessions__ViewportPolicy__Minimum__Height", "value": "100" },
          { "name": "Sessions__ViewportPolicy__Maximum__Width", "value": "4096" },
          { "name": "Sessions__ViewportPolicy__Maximum__Height", "value": "2160" },
          { "name": "Sessions__ClientEnvironmentPolicy__DefaultLocale", "value": "pt-BR" },
          { "name": "Sessions__ClientEnvironmentPolicy__DefaultLanguage", "value": "pt-BR" },
          { "name": "Sessions__ClientEnvironmentPolicy__DefaultTimeZoneId", "value": "America/Sao_Paulo" },
          { "name": "Sessions__ClientEnvironmentPolicy__DefaultColorScheme", "value": "light" },
          { "name": "Sessions__DeviceEmulationPolicy__Default__DeviceScaleFactor", "value": "1" },
          { "name": "Sessions__DeviceEmulationPolicy__Default__UserAgentProfile", "value": "desktop" },
          { "name": "Sessions__DeviceEmulationPolicy__Default__ScreenOrientation", "value": "landscapePrimary" },
          { "name": "Sessions__DeviceEmulationPolicy__MinDeviceScaleFactor", "value": "1" },
          { "name": "Sessions__DeviceEmulationPolicy__MaxDeviceScaleFactor", "value": "2" },
          { "name": "Sessions__DeviceEmulationPolicy__MaxTouchPoints", "value": "10" },
          { "name": "Sessions__DeviceEmulationPolicy__DefaultTouchPointsWhenTouch", "value": "5" },
          { "name": "Sessions__DeviceEmulationPolicy__DesktopUserAgentProfile", "value": "desktop" },
          { "name": "Sessions__DeviceEmulationPolicy__MobileUserAgentProfile", "value": "mobile" },
          { "name": "Sessions__ScreencastPolicy__MaxEncodeScale", "value": "2" }
        ],
        "volumes": [
          { "name": "speculum-refactor-dev-data", "container": "/data" },
          { "host": "/proc", "container": "/host/proc:ro" },
          { "host": "/var/run/docker.sock", "container": "/var/run/docker.sock:ro" }
        ],
        "compose": {
          "ports": ["8443:8443/tcp", "8443:8443/udp"]
        },
        "labels": [
          "traefik.enable=true",
          "traefik.http.routers.refactor-api.rule=PathPrefix(`/w7s/api`) || PathPrefix(`/w7s/vhub`) || PathPrefix(`/w7s/vstream`) || PathPrefix(`/w7s/health`) || PathPrefix(`/w7s/virtual-assets`) || PathPrefix(`/w7s/virtual-blob`) || PathPrefix(`/w7s/virtual-data`)",
          "traefik.http.routers.refactor-api.entrypoints=web",
          "traefik.http.routers.refactor-api.priority=100",
          "traefik.http.routers.refactor-api.service=refactor-api",
          "traefik.http.services.refactor-api.loadbalancer.server.port=8080"
        ]
      },
      {
        "id": "web",
        "image": "speculum-refactor-web",
        "context": ".",
        "dockerfile": "web/Dockerfile",
        "buildArgs": [
          { "name": "VITE_SPECULUM_TRANSPORT_ORIGIN", "value": "https://localhost:8443" }
        ],
        "dependsOn": [{ "id": "api", "condition": "service_healthy" }],
        "healthcheck": {
          "test": ["CMD", "wget", "-qO-", "http://localhost/"],
          "interval": "15s",
          "timeout": "5s",
          "startPeriod": "15s",
          "retries": 3
        },
        "labels": [
          "traefik.enable=true",
          "traefik.http.routers.refactor-web.rule=PathPrefix(`/`)",
          "traefik.http.routers.refactor-web.entrypoints=web",
          "traefik.http.routers.refactor-web.priority=1",
          "traefik.http.routers.refactor-web.service=refactor-web",
          "traefik.http.services.refactor-web.loadbalancer.server.port=80"
        ]
      }
    ],
    "volumes": [{ "name": "speculum-refactor-dev-data" }]
  },
  "prod": {
    "namespace": "websete",
    "network": "speculum",
    "tag": "latest",
    "env": [
      { "name": "PUBLIC_HOST", "value": "betano.digital" },
      { "name": "ACME_EMAIL", "value": "admin@betano.digital" },
      { "name": "TRANSPORT_ORIGIN", "value": "https://${PUBLIC_HOST}" }
    ],
    "containers": [
      {
        "id": "traefik",
        "imageRef": "traefik:v3.6.1",
        "restart": "unless-stopped",
        "dependsOn": [{ "id": "api", "condition": "service_healthy" }],
        "command": [
          "--api.dashboard=false",
          "--providers.docker=true",
          "--providers.docker.exposedbydefault=false",
          "--providers.docker.network=speculum",
          "--entrypoints.web.address=:80",
          "--entrypoints.web.http.redirections.entrypoint.to=websecure",
          "--entrypoints.web.http.redirections.entrypoint.scheme=https",
          "--entrypoints.websecure.address=:443",
          "--certificatesresolvers.le.acme.email=${ACME_EMAIL}",
          "--certificatesresolvers.le.acme.storage=/letsencrypt/acme.json",
          "--certificatesresolvers.le.acme.httpchallenge=true",
          "--certificatesresolvers.le.acme.httpchallenge.entrypoint=web"
        ],
        "compose": {
          "ports": ["80:80", "443:443/tcp"]
        },
        "volumes": [
          { "host": "/var/run/docker.sock", "container": "/var/run/docker.sock:ro" },
          { "name": "traefik-letsencrypt", "container": "/letsencrypt" }
        ]
      },
      {
        "id": "sidecar",
        "image": "speculum-sidecar",
        "context": ".",
        "dockerfile": "sidecar/Dockerfile",
        "restart": "unless-stopped",
        "init": true,
        "capAdd": ["SYS_ADMIN", "MKNOD"],
        "shmSize": "2gb",
        "compose": {
          "devices": ["/dev/uinput:/dev/uinput"],
          "device_cgroup_rules": [
            "c 10:223 rwm",
            "c 13:* rwm"
          ]
        },
        "env": [
          { "name": "NODE_ENV", "value": "production" },
          { "name": "SPECULUM_BROWSER", "value": "patchright" },
          { "name": "SPECULUM_INPUT_BACKEND", "value": "patchright" },
          { "name": "CHROME_EXECUTABLE", "value": "/usr/bin/google-chrome" },
          { "name": "SPECULUM_GRPC_PORT", "value": "50051" },
          { "name": "SPECULUM_HEALTH_PORT", "value": "3001" }
        ],
        "healthcheck": {
          "test": ["CMD", "curl", "-sf", "http://localhost:3001/ready"],
          "interval": "15s",
          "timeout": "5s",
          "startPeriod": "60s",
          "retries": 5
        }
      },
      {
        "id": "api",
        "image": "speculum-api",
        "context": ".",
        "dockerfile": "Speculum.Api/Dockerfile",
        "restart": "unless-stopped",
        "dependsOn": [{ "id": "sidecar", "condition": "service_healthy" }],
        "healthcheck": {
          "test": ["CMD", "curl", "-sf", "http://localhost:8080/w7s/health/live"],
          "interval": "15s",
          "timeout": "5s",
          "startPeriod": "25s",
          "retries": 5
        },
        "env": [
          { "name": "ASPNETCORE_ENVIRONMENT", "value": "Production" },
          { "name": "ASPNETCORE_URLS", "value": "http://0.0.0.0:8080" },
          { "name": "SPECULUM_WEBTRANSPORT_PORT", "value": "8443" },
          { "name": "Database__Path", "value": "/data/speculum.db" },
          { "name": "Sidecar__GrpcAddress", "value": "http://sidecar:50051" },
          { "name": "Telemetry__Host__ProcPath", "value": "/host/proc" },
          { "name": "Telemetry__Docker__Endpoint", "value": "unix:///var/run/docker.sock" },
          { "name": "ResourceManagement__Sessions__MaxConcurrentSessions", "value": "10" },
          { "name": "Sessions__DetachedSessionTimeout", "value": "00:00:03" },
          { "name": "Sessions__IsJsBridgeEnabled", "value": "true" },
          { "name": "Sessions__InputMultiplexingPolicy__Access", "value": "Shared" },
          { "name": "Sessions__ViewportPolicy__Default__Width", "value": "1280" },
          { "name": "Sessions__ViewportPolicy__Default__Height", "value": "720" },
          { "name": "Sessions__ViewportPolicy__Minimum__Width", "value": "100" },
          { "name": "Sessions__ViewportPolicy__Minimum__Height", "value": "100" },
          { "name": "Sessions__ViewportPolicy__Maximum__Width", "value": "4096" },
          { "name": "Sessions__ViewportPolicy__Maximum__Height", "value": "2160" },
          { "name": "Sessions__ClientEnvironmentPolicy__DefaultLocale", "value": "pt-BR" },
          { "name": "Sessions__ClientEnvironmentPolicy__DefaultLanguage", "value": "pt-BR" },
          { "name": "Sessions__ClientEnvironmentPolicy__DefaultTimeZoneId", "value": "America/Sao_Paulo" },
          { "name": "Sessions__ClientEnvironmentPolicy__DefaultColorScheme", "value": "light" },
          { "name": "Sessions__DeviceEmulationPolicy__Default__DeviceScaleFactor", "value": "1" },
          { "name": "Sessions__DeviceEmulationPolicy__Default__UserAgentProfile", "value": "desktop" },
          { "name": "Sessions__DeviceEmulationPolicy__Default__ScreenOrientation", "value": "landscapePrimary" },
          { "name": "Sessions__DeviceEmulationPolicy__MinDeviceScaleFactor", "value": "1" },
          { "name": "Sessions__DeviceEmulationPolicy__MaxDeviceScaleFactor", "value": "2" },
          { "name": "Sessions__DeviceEmulationPolicy__MaxTouchPoints", "value": "10" },
          { "name": "Sessions__DeviceEmulationPolicy__DefaultTouchPointsWhenTouch", "value": "5" },
          { "name": "Sessions__DeviceEmulationPolicy__DesktopUserAgentProfile", "value": "desktop" },
          { "name": "Sessions__DeviceEmulationPolicy__MobileUserAgentProfile", "value": "mobile" },
          { "name": "Sessions__ScreencastPolicy__MaxEncodeScale", "value": "2" }
        ],
        "volumes": [
          { "name": "speculum-refactor-data", "container": "/data" },
          { "host": "/proc", "container": "/host/proc:ro" },
          { "host": "/var/run/docker.sock", "container": "/var/run/docker.sock:ro" }
        ],
        "compose": {
          "ports": [
            "443:8443/udp",
            "8443:8443/tcp",
            "8443:8443/udp"
          ]
        },
        "labels": [
          "traefik.enable=true",
          "traefik.http.routers.speculum-api.rule=Host(`${PUBLIC_HOST}`) && (PathPrefix(`/w7s/api`) || PathPrefix(`/w7s/vhub`) || PathPrefix(`/w7s/vstream`) || PathPrefix(`/w7s/health`) || PathPrefix(`/w7s/virtual-assets`) || PathPrefix(`/w7s/virtual-blob`) || PathPrefix(`/w7s/virtual-data`))",
          "traefik.http.routers.speculum-api.entrypoints=websecure",
          "traefik.http.routers.speculum-api.tls.certresolver=le",
          "traefik.http.routers.speculum-api.priority=100",
          "traefik.http.routers.speculum-api.service=speculum-api",
          "traefik.http.services.speculum-api.loadbalancer.server.port=8080"
        ]
      },
      {
        "id": "web",
        "image": "speculum-web",
        "context": ".",
        "dockerfile": "web/Dockerfile",
        "restart": "unless-stopped",
        "buildArgs": [
          { "name": "VITE_SPECULUM_TRANSPORT_ORIGIN", "value": "${TRANSPORT_ORIGIN}" }
        ],
        "dependsOn": [{ "id": "api", "condition": "service_healthy" }],
        "healthcheck": {
