{
  "id": "input-click",
  "description": "M1a — root click intent changes Virtual DOM (#status clicked)",
  "sessionPolicy": "cold",
  "fold": "input-click",
  "queues": [
    {
      "name": "main",
      "actions": [
        { "id": "boot", "type": "boot", "params": { "url": "fixtures/input-click.html" } },
        { "id": "wait-settle", "type": "sleep", "dependsOn": ["boot"], "params": { "ms": 2000 } },
        { "id": "snap-before", "type": "snap", "dependsOn": ["wait-settle"], "params": { "id": "beforeClick", "cssom": "none", "includeTree": true } },
        {
          "id": "click-btn",
          "type": "pushDomInput",
          "dependsOn": ["snap-before"],
          "params": {
            "sequence": [
              { "type": "resolveAndClick", "selector": "#click-me" }
            ]
          }
        },
        { "id": "wait-click", "type": "sleep", "dependsOn": ["click-btn"], "params": { "ms": 500 } },
        { "id": "assert-clicked", "type": "evaluate", "dependsOn": ["wait-click"], "params": { "expression": "(() => { if (document.getElementById('status')?.getAttribute('data-state') !== 'clicked') throw new Error('status not clicked'); return 'ok'; })()" } },
        { "id": "snap-after", "type": "snap", "dependsOn": ["assert-clicked"], "params": { "id": "afterClick", "cssom": "none" } },
        { "id": "writeDossier", "type": "writeDossier", "dependsOn": ["snap-after"] }
      ]
    }
  ]
}
