+                                uint32_t aJsonLength) {}
+};
+
+SpeculumFrameSink& GetSpeculumFrameSink();
+
+#endif
diff --git a/dom/ipc/SpeculumProjectionRuntime.cpp b/dom/ipc/SpeculumProjectionRuntime.cpp
